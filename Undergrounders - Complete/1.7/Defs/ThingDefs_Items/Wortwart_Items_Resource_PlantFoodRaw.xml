<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="RoughPlantBase">
		<defName>undrgdrs_RawWortwart</defName>
		<label>wortwart</label>
		<description>Raw wortwart fungus. A fungus that both ferments and preserves, making something equivalent to beer.</description>
		<possessionCount>10</possessionCount>
		<graphicData>
			<texPath>Things/Item/Resource/Wortwart</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>1.3</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>30</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<ingestible>
			<preferability>DesperateOnly</preferability>
			<canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
		</ingestible>
	</ThingDef>
	
</Defs>