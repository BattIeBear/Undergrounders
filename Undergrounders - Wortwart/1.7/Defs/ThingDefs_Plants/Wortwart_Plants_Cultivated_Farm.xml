<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CavePlantBase">
		<defName>undrgdrs_Plant_Wortwart</defName>
		<label>wortwart</label>
		<description>This variant of the fungus was bioengineered to produce preservatives and fermenting agents, able to be turned into beer on planets with low sunlight. It can grow on fungal gravel, but only in darkness - exposing it to any kind of light, including darklights, will kill it.</description>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<Nutrition>0.2</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/Wortwart</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>1.7</drawSize>
		</graphicData>
    <uiIconScale>0.588</uiIconScale>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <pathCost>14</pathCost>
		<ingestible />
		<plant>
			<fertilitySensitivity>0.7</fertilitySensitivity>
			<growDays>20</growDays><!--20-->
			<dieIfLeafless>true</dieIfLeafless>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>undrgdrs_RawWortwart</harvestedThingDef>
			<drugForHarvestPurposes>True</drugForHarvestPurposes>
			<harvestYield>8</harvestYield>
			<sowMinSkill>3</sowMinSkill>
			<neverBlightable>true</neverBlightable>
			<sowTags>
				<li>Ground</li>
			</sowTags>
			<sowResearchPrerequisites>
				<li>Brewing</li>
			</sowResearchPrerequisites>
			<topWindExposure>0</topWindExposure>
			<cavePlantWeight>0</cavePlantWeight>
			<visualSizeRange>0.4~0.7</visualSizeRange>
			<wildOrder>2</wildOrder>
		</plant>
	</ThingDef>
	
</Defs>